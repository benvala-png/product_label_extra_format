<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_simple_label3x7">
            <!-- Le code-barres était à 30 mm de large dans une colonne qui n'en
                 fait que 26,4 mm (40 % des 66 mm de l'étiquette, réglé par le CSS
                 du core), donc serré et parfois rogné. Un EAN-13 mesure 37,29 mm
                 à taille nominale : à 30 mm on était à 80 %, la limite basse
                 admise par GS1, et les codes les plus chargés devenaient
                 illisibles au lecteur — signalé par Benjamin le 2026-08-23.
                 On élargit la colonne ET l'image. -->
            <t t-set="barcode_size" t-value="'width:38mm;height:14mm'"/>
            <t t-set="table_style" t-value="'width:66mm;height:37.1mm;' + table_style"/>
            <td t-att-style="make_invisible and 'visibility:hidden;'">
                <div class="o_label_full" t-att-style="table_style">
                    <!-- Étiquette rayon, lue par le client : pas de référence interne.
                         `default_code` est ici une copie du code-barres sur 2221 fiches
                         sur 2265 — il apparaissait donc 3 fois (préfixe du nom, colonne
                         gauche, chiffres sous le code-barres) sur 66 mm de large.
                         Sur un product.product, `display_default_code=False` retire le
                         préfixe ; sur un product.template le flag est ignoré, d'où le
                         repli sur `name` (même raison que dans l'étiquette 2x4). -->
                    <div class="o_label_name" style="white-space:nowrap;overflow:hidden;">
                        <strong t-if="product.is_product_variant"
                                t-out="product.with_context(display_default_code=False).display_name"/>
                        <strong t-else="" t-field="product.name"/>
                    </div>
                    <!-- L'origine est une information destinée au client, et
                         obligatoire sur les fruits et légumes non préemballés :
                         elle est donc lisible, contrairement au bloc fournisseur
                         qui ne sert qu'en interne. -->
                    <div t-if="product.allergen_origin"
                         style="padding:0 4px;font-size:10px;line-height:1.1;white-space:nowrap;overflow:hidden;">
                        <strong>Origine : </strong>
                        <span t-out="product.allergen_origin"/>
                    </div>

                    <div class="o_label_data">
                        <div class="text-center o_label_left_column" style="width:60%;">
                            <t t-if="barcode">
                                <div t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': barcode_size}"/>
                                <span class="text-center" t-out="barcode"/>
                            </t>
                        </div>
                        <div class="text-end" style="line-height:normal">
                            <div class="o_label_extra_data" style="font-size:6px;color:#888;">
                                <t t-if="product.x_last_auto_supplier_id" t-out="'Fourn: %s' % product.x_last_auto_supplier_id.name"/>
                                <br t-if="product.x_last_auto_supplier_id and product.x_last_auto_date"/>
                                <t t-if="product.x_last_auto_date" t-out="'MAJ: %s' % product.x_last_auto_date.strftime('%d/%m/%Y')"/>
                            </div>
                            <t t-if="product.is_product_variant">
                                <strong class="o_label_price" t-field="product.lst_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                            </t>
                            <t t-else="">
                                <strong class="o_label_price" t-field="product.list_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                            </t>
                        </div>
                        <div class="o_label_clear"/>
                    </div>
                </div>
            </td>
        </template>

        <template id="report_productlabel_3x7_inherit" inherit_id="product.report_productlabel">
            <xpath expr="//t[@t-if=&quot;columns == 2 and rows == 7&quot;]" position="after">
                <t t-if="columns == 3 and rows == 7">
                    <t t-set="padding_page" t-value="'padding: 14mm 3mm'"/>
                    <t t-set="report_to_call" t-value="'product_label_extra_format.report_simple_label3x7'"/>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
