<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Étiquette mini, ~24 mm de large (8 colonnes sur l'A4) : pour les
             petits contenants (huiles essentielles, flacons) où une étiquette
             produit classique (66-97 mm) ne tient pas. Pas de code-barres ni
             de référence — juste ce qu'un client lit sur le rayon, nom et
             prix, comme demandé le 2026-09-29. -->
        <template id="report_simple_label_mini">
            <t t-set="table_style" t-value="'width:24mm;height:20mm;' + table_style"/>
            <td t-att-style="make_invisible and 'visibility:hidden;'">
                <div class="o_label_full o_label_small_text" t-att-style="table_style">
                    <!-- Même repli que l'étiquette 3x7 : display_name préfixe
                         la référence interne sur un product.product, jamais
                         voulu sur une étiquette client. -->
                    <t t-set="nom_etiquette"
                       t-value="product.with_context(display_default_code=False).display_name
                                if product.is_product_variant else product.name"/>
                    <div class="o_label_name"
                         style="height:2.1em;font-size:90%;line-height:1.15;
                                overflow:hidden;overflow-wrap:break-word;padding:1px 2px;">
                        <strong t-out="nom_etiquette"/>
                    </div>
                    <div class="text-center" style="padding:1px 2px;">
                        <t t-if="product.is_product_variant">
                            <strong class="o_label_price_small" t-field="product.lst_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                        <t t-else="">
                            <strong class="o_label_price_small" t-field="product.list_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                    </div>
                </div>
            </td>
        </template>

        <template id="report_productlabel_mini_inherit" inherit_id="product.report_productlabel">
            <xpath expr="//t[@t-if=&quot;columns == 2 and rows == 7&quot;]" position="after">
                <t t-if="columns == 8 and rows == 10">
                    <t t-set="padding_page" t-value="'padding: 10mm 3mm'"/>
                    <t t-set="report_to_call" t-value="'product_label_extra_format.report_simple_label_mini'"/>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
