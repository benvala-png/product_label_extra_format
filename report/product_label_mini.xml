<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Étiquette mini, ~36 mm de large (5 colonnes sur l'A4) : pour les
             petits contenants (huiles essentielles, flacons) où une étiquette
             produit classique (66-97 mm) ne tient pas. Pas de code-barres ni
             de référence — juste ce qu'un client lit sur le rayon, nom et
             prix, comme demandé le 2026-09-29.
             Agrandie de 50% le même jour (24→36 mm, 20→30 mm), puis la
             police du nom montée à 20px : toujours illisible en pratique,
             pas à cause de la taille mais parce que TOUT était forcé sur une
             police fixe et 2 lignes — or les noms vont de 13 à 46 caractères
             (catalogue Bioflore, une fois la marque retirée). Passage à une
             taille adaptative, même principe que le format 2x4 ingrédients
             du même module (`nom_court` / `nom_size`) : plus le nom est
             long, plus la police descend et plus on autorise de lignes.
             La marque est retirée de l'affichage (déjà sur 87 des 98 fiches
             Bioflore actuelles, "Bioflore - Nom - Poids") pour ne pas
             gâcher de la place avec une information déjà connue en rayon —
             seulement quand le nom COMMENCE par la marque, jamais si
             "Bioflore" est ailleurs dans le nom (ex. "Diffuseur par
             capillarité - Bioflore", marque en suffixe, laissé intact).
             Hauteur de boîte = 0.86 × lignes × police × 1.2 : facteur
             empirique qui a évité le reliquat de ligne tronquée sur les deux
             réglages précédents (41px pour 20px/2 lignes, 33px pour
             16px/2 lignes — les deux collent exactement à cette formule). -->
        <template id="report_simple_label_mini">
            <t t-set="table_style" t-value="'width:36mm;height:30mm;position:relative;' + table_style"/>
            <td t-att-style="make_invisible and 'visibility:hidden;'">
                <div class="o_label_full" t-att-style="table_style">
                    <!-- Même repli que l'étiquette 3x7 : display_name préfixe
                         la référence interne sur un product.product, jamais
                         voulu sur une étiquette client. -->
                    <t t-set="nom_etiquette"
                       t-value="product.with_context(display_default_code=False).display_name
                                if product.is_product_variant else product.name"/>
                    <t t-set="brut" t-value="(nom_etiquette or '').strip()"/>
                    <t t-set="nom_sans_marque"
                       t-value="brut.split('-', 1)[1].strip()
                                if brut.lower().startswith('bioflore') and '-' in brut
                                else brut"/>
                    <!-- La zone du nom est montée au maximum de ce que la
                         boîte de 30mm laisse (~113px) une fois le prix
                         retiré (~30px, ancré en bas).
                         Piège trouvé le 2026-09-29, DEUX fois de suite :
                         « Tea Tree - 10ml » puis « Verveine - 200ml »
                         (16 caractères pile, palier "court") coupaient tous
                         les deux leur dernière ligne. La hauteur calculée à
                         lignes × police × 1.2 (+3px) donnait 46px pour 2
                         lignes à 18px — mesuré insuffisant sur le rendu réel
                         (capture HTML brute envoyée à la passerelle
                         d'impression). Le moteur de rendu de la passerelle
                         prend visiblement plus de place par ligne que
                         1.2 × la taille de police ne le suppose. On repart
                         donc d'une marge largement plus généreuse
                         (× 1.5 + 8px fixes) plutôt que de recalculer au plus
                         juste une 3e fois — le risque à éviter est de perdre
                         une ligne utile, pas de gagner quelques mm de vide. -->
                    <t t-set="n" t-value="len(nom_sans_marque)"/>
                    <t t-set="nom_taille" t-value="18 if n &lt;= 16 else 13"/>
                    <t t-set="nom_lignes" t-value="2 if n &lt;= 16 else 3"/>
                    <t t-set="nom_hauteur" t-value="round(nom_lignes * nom_taille * 1.5) + 8"/>
                    <div class="o_label_name"
                         t-attf-style="height:#{nom_hauteur}px;font-size:#{nom_taille}px;line-height:1.2;
                                       overflow:hidden;word-wrap:break-word;overflow-wrap:break-word;
                                       word-break:break-word;padding:2px 3px;">
                        <strong t-out="nom_sans_marque"/>
                    </div>
                    <!-- Ancré en bas de l'étiquette (position absolute dans
                         .o_label_full, mis en position:relative ci-dessus)
                         plutôt que juste sous le nom : reste au même
                         endroit quelle que soit la hauteur prise par le nom,
                         demandé le 2026-09-29. -->
                    <div class="text-center" style="padding:2px 3px;position:absolute;left:0;right:0;bottom:2px;">
                        <t t-if="product.is_product_variant">
                            <strong style="font-size:22px;" t-field="product.lst_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                        <t t-else="">
                            <strong style="font-size:22px;" t-field="product.list_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                    </div>
                </div>
            </td>
        </template>

        <template id="report_productlabel_mini_inherit" inherit_id="product.report_productlabel">
            <xpath expr="//t[@t-if=&quot;columns == 2 and rows == 7&quot;]" position="after">
                <t t-if="columns == 5 and rows == 8">
                    <t t-set="padding_page" t-value="'padding: 10mm 3mm'"/>
                    <t t-set="report_to_call" t-value="'product_label_extra_format.report_simple_label_mini'"/>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
