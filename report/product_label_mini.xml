<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Étiquette mini, 36 x 30 mm (5 x 8 sur l'A4) : petits contenants
             (huiles essentielles, épices). Sans code-barres jusqu'au
             2026-10-08 ; le code-barres y a été ajouté pour les épices Cook,
             validé sur les 3 lecteurs du magasin, et Benjamin a demandé de ne
             garder que cette version.

             Code-barres : 128 px CSS = 4/3 de pouce = 800 points à 600 dpi,
             image générée en 800 px — même principe que le 3x7 (un pixel de
             l'image = un point du Canon, aucun rééchantillonnage, voir le
             commentaire de product_label_report_extra.xml). Le 144 px du 3x7
             ne tient pas dans 36 mm. 800 / 113 modules = 7,08 points par
             module, donc plus proche d'un entier que les 7,96 du 3x7 ; le
             module fait 0,30 mm, soit ~91 % de la taille nominale EAN-13
             (minimum GS1 : 80 %). Pas de chiffres sous les barres : la place
             manque, et le client ne les lit pas.

             Empilement, ancré en bas : code-barres (34 px) puis prix (18 px).
             Le nom prend le haut, 50 px au plus : 2 lignes à 15 ou 13 px, 3 lignes à 11 px
             au-delà de 26 caractères (« Hydrolat d'Hamamélis bio - 200ml » perdait
             sa 3e ligne à 13 px).
             La marque en tête du nom est retirée (Bioflore, Cook) : elle se
             voit sur le flacon, et on gagne une demi-ligne. -->
        <template id="report_simple_label_mini">
            <t t-set="table_style" t-value="'width:36mm;height:30mm;position:relative;' + table_style"/>
            <td t-att-style="make_invisible and 'visibility:hidden;'">
                <div class="o_label_full" t-att-style="table_style">
                    <t t-set="nom_etiquette"
                       t-value="product.with_context(display_default_code=False).display_name
                                if product.is_product_variant else product.name"/>
                    <t t-set="brut" t-value="(nom_etiquette or '').strip()"/>
                    <t t-set="nom_sans_marque"
                       t-value="brut.split('-', 1)[1].strip()
                                if brut.lower().startswith(('bioflore', 'cook')) and '-' in brut
                                else brut"/>
                    <t t-set="n" t-value="len(nom_sans_marque)"/>
                    <t t-set="nom_taille" t-value="15 if n &lt;= 18 else (13 if n &lt;= 26 else 11)"/>
                    <div class="o_label_name"
                         t-attf-style="height:50px;font-size:#{nom_taille}px;line-height:1.2;
                                       overflow:hidden;word-wrap:break-word;overflow-wrap:break-word;
                                       word-break:break-word;padding:2px 3px;">
                        <strong t-out="nom_sans_marque"/>
                    </div>
                    <div class="text-center" style="position:absolute;left:0;right:0;bottom:38px;line-height:1;">
                        <t t-if="product.is_product_variant">
                            <strong style="font-size:18px;" t-field="product.lst_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                        <t t-else="">
                            <strong style="font-size:18px;" t-field="product.list_price" t-options="{'widget': 'monetary', 'label_price': True}"/>
                        </t>
                    </div>
                    <div t-if="barcode" style="position:absolute;left:0;right:0;bottom:2px;text-align:center;line-height:0;">
                        <div t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 800, 'height': 213, 'img_style': 'width:128px;height:34px;display:inline-block'}"/>
                    </div>
                </div>
            </td>
        </template>

        <template id="report_productlabel_mini_inherit" inherit_id="product.report_productlabel">
            <xpath expr="//t[@t-if=&quot;columns == 2 and rows == 7&quot;]" position="after">
                <t t-if="columns == 5 and rows == 8">
                    <t t-set="padding_page" t-value="'padding: 10mm 3mm'"/>
                    <t t-set="report_to_call" t-value="'product_label_extra_format.report_simple_label_mini'"/>
                </t>
            </xpath>
        </template>

    </data>
</odoo>
